# ==============================
# Backend (FastAPI + NebulaGraph)
# ==============================
NEBULA_HOST=127.0.0.1
NEBULA_PORT=9669
NEBULA_USER=root
NEBULA_PASSWORD=CHANGE_ME
NEBULA_SPACE=demo_kg
NEBULA_TIMEOUT_MS=5000
NEBULA_POOL_SIZE=10
EDGE_TYPE=REL2

# search limits
CANDIDATE_LIMIT=300
DESC_CANDIDATE_LIMIT=50
TOPK=100
MAX_EDGES_RETURN=3000
SEARCH_MIN_QUERY_LEN=3
SEARCH_INCLUDE_EDGES_DEFAULT=0
DEBUG_PROBE=0
FALLBACK_ENABLE_SCAN=0

# edge search tune
EDGE_SUGGEST_SCAN_LIMIT=1500
EDGE_SEARCH_SCAN_LIMIT=8000
EDGE_PROP_VALUE_MAX_LEN=300
EDGE_PROP_MAX_FIELDS=24
EDGE_SNIPPET_MAX_LEN=90

# Search v2 budget / behavior
SEARCH_V2_MIN_QUERY_LEN=3
SEARCH_V2_SUGGEST_MIN_QUERY_LEN=2
SEARCH_V2_TOPK=100
SEARCH_V2_ES_TOPK=120
SEARCH_V2_SUGGEST_LIMIT_MAX=20
SEARCH_V2_SUGGEST_RAW_ID_LIMIT_MAX=50
SEARCH_V2_INCLUDE_EDGES_DEFAULT=0
SEARCH_V2_INCLUDE_EDGES_ALLOW=1
SEARCH_V2_INCLUDE_EDGES_NODE_CAP=40
SEARCH_V2_INCLUDE_EDGES_EDGE_LIMIT=1200
SEARCH_V2_ES_HEALTH_TTL_SEC=3
SEARCH_V2_ES_TIMEOUT_MS=1200

# Graph query budget (subgraph / expand / multi_entity_graph)
GRAPH_REL_FILTER_MAX=120

GRAPH_SUBGRAPH_HOP_MAX=3
GRAPH_SUBGRAPH_MAX_NODES_CAP=300
GRAPH_SUBGRAPH_MAX_EDGES_CAP=1200
GRAPH_SUBGRAPH_FRONTIER_CAP=200
GRAPH_SUBGRAPH_PER_ROOT_NEIGHBOR_CAP=120
GRAPH_SUBGRAPH_QUERY_EDGE_SCAN_CAP=50000

GRAPH_EXPAND_EXISTING_NODE_CAP=2000
GRAPH_EXPAND_MAX_NODES_CAP=300
GRAPH_EXPAND_MAX_EDGES_CAP=1200
GRAPH_EXPAND_PER_ROOT_NEIGHBOR_CAP=200
GRAPH_EXPAND_QUERY_EDGE_SCAN_CAP=50000

GRAPH_MULTI_ROOT_CAP=8
GRAPH_MULTI_K_MAX=3
GRAPH_MULTI_MAX_NODES_CAP=600
GRAPH_MULTI_MAX_EDGES_CAP=2500
GRAPH_MULTI_PAIR_CANDIDATE_CAP=3
GRAPH_MULTI_PER_ROOT_NEIGHBOR_CAP=120
GRAPH_MULTI_QUERY_EDGE_SCAN_CAP=60000

# ES (full text search)
ES_ENABLED=1
ES_URL=http://127.0.0.1:9200
ES_INDEX=kg_entity
ES_TIMEOUT_MS=1200
ES_TOPK=120

# observability
DEV_INSTANCE_TRACE=1

# ==============================
# Frontend (Vite)
# ==============================
VITE_API_BASE_URL=http://127.0.0.1:8000
